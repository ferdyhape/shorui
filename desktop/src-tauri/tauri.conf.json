{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shorui",
  "version": "0.1.0",
  "identifier": "com.ferdyhape.shorui",
  "build": {
    "frontendDist": "dist-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Shorui",
        "width": 1180,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:47821"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "binaries/backend": "binaries/backend"
    }
  }
}
